[databases]
{% for db in application_databases %}
{{ db.name }} = host={{ node.dns_name }} port={{ pg_port }} dbname={{ db.name }}
{% endfor %}

[pgbouncer]
listen_addr = {{ node.address }}
listen_port = {{ pool_port }}
unix_socket_dir = /run/pg-ha-pgbouncer
auth_type = scram-sha-256
auth_file = /etc/pg-ha/pgbouncer/userlist.txt
pool_mode = {{ cluster.pool.mode }}
max_client_conn = {{ cluster.pool.max_client_conn }}
default_pool_size = {{ cluster.pool.default_pool_size }}
reserve_pool_size = {{ cluster.pool.reserve_pool_size }}
max_db_connections = {{ cluster.pool.max_db_connections }}
server_reset_query = DISCARD ALL
server_connect_timeout = {{ cluster.timeouts.connect_seconds }}
client_tls_sslmode = require
client_tls_cert_file = /etc/pg-ha/pgbouncer/cert.pem
client_tls_key_file = /etc/pg-ha/pgbouncer/key.pem
client_tls_ca_file = /etc/pg-ha/pgbouncer/ca.pem
client_tls_protocols = secure
server_tls_sslmode = verify-full
server_tls_ca_file = /etc/pg-ha/pgbouncer/ca.pem
server_tls_protocols = secure
log_connections = 1
log_disconnections = 1
log_pooler_errors = 1
pidfile = /run/pg-ha-pgbouncer/pgbouncer.pid

# Controller options only. Copy to .env; never store passwords here.
# Precedence: explicit CLI option > process environment > this file > safe default.
# Relative paths are resolved against the project root. ~/ means controller home.
# No shell expansion, export statements, or inline comments are supported.
PGHA_INVENTORY=inventories/local/hosts.yml
PGHA_KNOWN_HOSTS=~/.local/share/pg-ha/local/known_hosts
PGHA_COLLECTIONS_PATH=~/.local/share/pg-ha/collections
PGHA_STATE_DIR=~/.local/share/pg-ha
PGHA_SSH_AUTH=key
PGHA_BECOME_AUTH=password
# Optional: models must use major: '{{ postgresql_version }}'. No automatic upgrade.
# POSTGRES_VERSION=17
# Opt-in modular model options; YAML model must reference these variables.
# ENABLE_BACKUP=false
# ENABLE_HAPROXY=true
# BACKUP_TARGET_PATH=/srv/pg-backups/repository

# Model must bind extensions: "{{ postgresql_extensions }}". Empty means no extras.
# POSTGRES_EXTENSIONS=pgcrypto,pgvector,timescaledb
